package electronicsyearlysales;

/**
 *
 * @author Student
 */
public class ElectronicsYearlySales {
    public static void main(String[] args) {

        String[] cities = {"CAPE TOWN", "PORT ELIZABETH", "PRETORIA"};
        int[][] sales = {
            {1000, 2000, 3000},
            {2000, 3000, 4000},
            {1500, 1100, 1200}
        };

        int[] totalSales = new int[3];
        int maxSales = 0;
        String topCity = "";

        System.out.println("GAMING CONSOLE REPORT");
        System.out.println(" PS5 XBOX SWITCH");

        for (int i = 0; i < cities.length; i++) {
            System.out.printf("%-20s %-10d %-10d %-10d\n", cities[i], sales[i][0], sales[i][1], sales[i][2]);
            totalSales[i] = sales[i][0] + sales[i][1] + sales[i][2];

            if (totalSales[i] > maxSales) {
                maxSales = totalSales[i];
                topCity = cities[i];
            }
        }

        System.out.println("CONSOLE SALES TOTALS FOR EACH CITY");

        for (int i = 0; i < cities.length; i++) {
            System.out.println(cities[i] + " " + totalSales[i]);
        }

        System.out.println("CITY WITH THE MOST SALES: " + topCity);
    }
}